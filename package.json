{
  "name": "pizzaclub",
  "description": "My tasty Pizza Adventure around the World.",
  "version": "2.0.0",
  "type": "module",
  "author": {
    "name": "Luca Lischetti",
    "email": "luca@sirlisko.com",
    "url": "https://sirlisko.com"
  },
  "homepage": "https://pizzaclub.sirlisko.com",
  "dependencies": {
    "@sanity/client": "^8",
    "@sanity/image-url": "^2",
    "astro": "^7",
    "maplibre-gl": "^6"
  },
  "devDependencies": {
    "prettier": "^3",
    "prettier-plugin-astro": "^1"
  },
  "keywords": [
    "pizza"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node validate-content.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write 'src/**/*.{astro,ts,js}'",
    "studio": "npm --prefix sanity run dev",
    "studio:build": "npm --prefix sanity run build",
    "studio:deploy": "npm --prefix sanity run deploy"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sirlisko/pizzaclub"
  }
}
